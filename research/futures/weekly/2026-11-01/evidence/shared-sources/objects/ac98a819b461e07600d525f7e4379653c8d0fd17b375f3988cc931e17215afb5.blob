<script>
var IE = !!window.ActiveXObject || "ActiveXObject" in window;
var dom = document.getElementById('iePopupWrap');
var closeDom = document.getElementById('iePopup-close');
if (IE) {
dom.style.display = 'block';
}
// 跳edge
function jumpEdge() {
window.location.href = 'https://www.microsoftedgeinsider.com/zh-cn/';
}
function closeFun(e) {
dom.style.display = 'none';
var evt = e || window.event;
evt.stopPropagation ? evt.stopPropagation() : evt.cancelBubble = true;
}
// 兼容ie7,8
if (window.addEventListener) {
closeDom.addEventListener('click',function(e){
closeFun(e);
});
} else {
closeDom.attachEvent('onclick',function(e){
closeFun(e);
});
}
</script> <script src="https://qhrs.eastmoney.com/static/lib/qrcode.js"></script>
