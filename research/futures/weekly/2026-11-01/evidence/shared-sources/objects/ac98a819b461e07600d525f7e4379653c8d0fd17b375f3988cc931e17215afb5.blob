<script src="https://qhrs.eastmoney.com/static/js/utils.js?v=1792483622782"></script>
<script>
utils.tracker();
utils.logger('140000328111');
var CACHE_KEY = 'article_fontsize';
// 链接
var LINKS = [
'http://guba.eastmoney.com/share.aspx',
'http://service.weibo.com/share/share.php',
'',
'http://sns.qzone.qq.com/cgi-bin/qzshare/cgi_qzshare_onekey'
];
var imgLogoUrl = 'https://qhemrs.eastmoney.com/h5/resources/images/share.png';
var PICTURE = encodeURIComponent(imgLogoUrl);
document.addEventListener('click', function(e) {
var target = e.target;
while (target && target.tagName !== 'A') {
target = target.parentElement;
}
if (target && target.tagName === 'A') {
var href = target.getAttribute('href');
if (href && href !== '#' && !href.startsWith('javascript:') && !href.startsWith('#')) {
// 检查是否在QTUOS环境中
if (window.pcBridge && window.pcBridge.isInQTUOS) {
e.preventDefault(); // 阻止默认跳转
window.pcBridge.OpenInBrowser(href); // 使用pcBridge跳转
}
// 其他情况保持原有的跳转行为
}
}
});
function handleJump(url) {
if (window.pcBridge && window.pcBridge.isInQTUOS) {
return window.pcBridge.OpenInBrowser(url)
}
if (typeof window.OpenInBrowser === 'function') {
window.OpenInBrowser(url)
}
}
var vmDetail = new Vue({
el: '#leftBox',
data: function () {
return {
act: 1,
titleFmt: '',
descFmt: '',
wxshareFlg: false,
imgUrl: '',
imgLogoUrl: imgLogoUrl,
fontsizeArr: ['大字', '标准', '小字'],
txtArr: ['股吧', '新浪微博', '微信', 'QQ空间'],
jubaoHref: 'http://help.eastmoney.com/report_center.html?reportType=3&title=' + encodeURIComponent('农产品 | 南美大豆产量风险加大 关注后期南美天气变化') + '&systype=3&id=202610233904969353&newsurl=' + window.location.href,
briefInfo: {
post_comment_authority_flag: false, // 是否允许评论 true 为不允许评论
allow_likes_state_flag: true, // 是否允许点赞
repost_state_flag: true, // 是否允许转发
},
}
},
beforeCreate: function() {
if (window.pcBridge) {
window.pcBridge.init(function() {
window.pcBridge.connectAppInfo();
});
}
},
mounted: function () {
this.act = Number(localStorage.getItem(CACHE_KEY) || 1)
var that = this;
var desc = '豆粕：隔夜豆粕依托3250元/吨震荡，10月份美豆收割压力上升，截至2026年10月18日当周，美国大豆收割率为64%，五年均值为65%。10月份以来美豆出口转弱，截至10月2日当周美国2026/2027年度大豆出口净销售为54.94万吨，环比下降46.85%，出口端支撑减弱。';
Object.assign(this, {
titleFmt: encodeURIComponent('农产品 | 南美大豆产量风险加大 关注后期南美天气变化'),
// qq分享最多显示120字
descFmt: encodeURIComponent(desc.length > 120 ? desc.substring(0, 118) + '...' : desc)
})
// 转码
var base64 = encodeURIComponent(btoa('articleid=202610233904969353&uid=""'))
QRCode.toDataURL('https://qhh5.eastmoney.com/news/#/?code=' + base64).then(function (url) {
that.imgUrl = url;
}).catch(function (err) {
console.error(err);
});
// 埋点上报
this.dataCollect();
},
methods: {
// 改变字体大小
changeFontSize: function (idx) {
this.act = idx
localStorage.setItem(CACHE_KEY, idx)
},
handleShareClick: function (idx) {
var title = this.titleFmt;
var desc = this.descFmt;
var wxshareFlg = this.wxshareFlg;
var str = ''
// 返回
if (!('org.sothis.web.qhsite.bo.NewsDetailBo@1f20f455' && 'org.sothis.web.qhsite.bo.NewsBo@20cc2a5d')) return
// 点其他区域，关闭
if (idx === -1) {
this.wxshareFlg = false
return
}
// 二维码
if (idx === 2) {
this.wxshareFlg = !wxshareFlg
return
}
// 0 股吧 1微博 3 qq空间
var obj = Object.assign({url: encodeURIComponent(window.location.href), title: title}, idx === 1 ? {
searchPic: false, pic: PICTURE
} : idx === 3 ? {
// summary: '',
desc: desc, pics: PICTURE
} : {})
// 循环拼接字符串
Object.keys(obj).forEach(function (key, idx) {
str += (idx !== 0 ? '&' : '') + key + '=' + obj[key];
});
var linkUrl = LINKS[idx] + '?' + str;
if (window.pcBridge && window.pcBridge.isInQTUOS) {
return window.pcBridge.OpenInBrowser(linkUrl)
}
// 跳转兼容pc客户端
typeof window.OpenInBrowser === 'function' ? window.OpenInBrowser(linkUrl) : window.open(linkUrl);
},
handleJumpClick: function (url) {
handleJump(url)
},
// 埋点上报
dataCollect: function () {
axios.post(apis.dataCollect, {
event_type: 1,
source: 14,
collect_mode: 2,
info_type: 1,
info_id: '202610233904969353',
req_id: utils.getUuid()
});
},
changeBrief:function (brief){
console.log(brief,'brief')
this.briefInfo=brief
if(brief.post_comment_authority_flag){
document.getElementById('desc').style.display = 'none';
}
}
}
})
</script>
