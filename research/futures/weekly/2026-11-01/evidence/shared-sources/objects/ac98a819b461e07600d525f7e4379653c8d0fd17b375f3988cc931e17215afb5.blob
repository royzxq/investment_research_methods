<script>
var vm = new Vue({
el: '#floatWrap',
data: function () {
return {
// 是否显示
showFlg: true,
// 隐藏内容
hideContFlg: false,
scrollFlg: false,
// 是否是xp
isXP: false,
// 开户地址
kaihuHref: 'https://qs.dfcfw.com/1629',
// 下载
downloadUrl: 'https://qs.dfcfw.com/7681',
// xp下载
downloadXPUrl: 'https://qs.dfcfw.com/3355'
}
},
mounted: function () {
var name = 'xinwen' || 'detail';
var listArr = ['xinwen', 'kuaixunc', 'headlines', 'hangqing', 'tradinghours', 'longhubang']
// 资讯
this.hideContFlg = listArr.indexOf(name) !== -1
this.jumpXP()
// 帮助中心展示
if (name == 'help') {
var that = this
return setTimeout(function () {
that.scrollFlg = true
}, 20)
}
// 滚动监听
this.scrollEvtInit(true)
},
beforeDestroy: function () {
this.scrollEvtInit()
},
methods: {
// 判断是否是xp
jumpXP: function () {
var ua = navigator.userAgent
if (ua.indexOf('Windows NT 5.1') !== -1 || ua.indexOf('Windows XP') !== -1) {
this.isXP = true
}
},
// 设置/销毁滚动监听
scrollEvtInit: function (flg) {
window[(flg ? 'add' : 'remove') + 'EventListener']('scroll', this.handleScroll)
},
// 滚动监听
handleScroll: function (e) {
// 获取到页面滚动的值
var sclTop = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop
this.scrollFlg = sclTop > 580
},
// 关闭
close: function () {
this.showFlg = false
},
// 回顶部
handleTopClick: function () {
window.scrollTo(0, 0)
}
}
})
</script>
