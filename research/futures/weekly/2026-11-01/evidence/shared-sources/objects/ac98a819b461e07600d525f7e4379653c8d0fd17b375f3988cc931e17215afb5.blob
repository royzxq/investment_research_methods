<script src="https://qhrs.eastmoney.com/static/js/pcBridge.js?v=1792483622782"></script>
<script src="https://qhrs.eastmoney.com/static/lib/jquery3.5.1.min.js"></script>
<script src="https://qhweb.eastmoney.com/xinwen/emoji-comment.js"></script>
<script src="https://qhrs.eastmoney.com/static/js/utils.js?v=1792483622782"></script>
<script>
// jsonp 请求的基础参数
var baseParams = {
postid: '',
// 默认用户名的md5
deviceid: '',
version: '1.0.0',
product: 'Futures',
plat: 'web',
_: 1640585326852
}
var briefInfo = {};
var ptm = {
// 接口
url: 'https://gbapi.emhudong.cn/'
}
// 配置 p第几页 initFlg 第一次请求 finishedFlg 数据全部加载
var actions = [
{text: '最新', opt: {sort: 1, sorttype: 1, p: 1}, initFlg: true, finishedFlg: true},
{text: '最热', opt: {sort: 1, sorttype: -1, p: 1}, initFlg: true, finishedFlg: true},
{text: '最早', opt: {sort: -1, sorttype: 1, p: 1}, initFlg: true, finishedFlg: true}
]
var vm = new Vue({
el: '#commentWrap',
data: function () {
return {
// 通过 actions 属性来定义菜单选项
actions: actions,
act: 0,
// 评论
replyList: [[], [], []],
list: [],
line: 5,
lineHeight: 18,
// 是否显示
showFlg: false,
// 是否展开全部评论
expandFlg: false,
// 子评论页数
p: 1,
briefInfo: {
post_comment_authority_flag: false, // 是否允许评论 true 为不允许评论
allow_likes_state_flag: true, // 是否允许点赞
repost_state_flag: true, // 是否允许转发
},
}
},
beforeCreate: function() {
if (window.pcBridge) {
window.pcBridge.init(function() {
window.pcBridge.connectAppInfo();
});
}
},
mounted: function () {
this.setPostId();
},
methods: {
setPostId: function () {
var formatNum = this.formatNum;
var that = this;
$.ajax({
url: apis.briefInfo,
type: "GET",
dataType: "jsonp", //指定服务器返回的数据类型
jsonpCallback: "jsonpdata",
data: Object.assign(baseParams, {type: 1, postid: this.getNewsId()}),
success: function (data) {
var obj = data.re[0];
var post_uid = obj.post_uid;
var post_id = obj.post_id;
// post_uid存在
if (post_uid) {
// 赋值
Object.assign(baseParams, {postid: post_id});
// 评论、分享
var post_comment_count = obj.post_comment_count;
var post_forward_count = obj.post_forward_count;
var post_comment_authority_flag = obj.post_comment_authory === 3
var allow_likes_state_flag = obj.allow_likes_state === 1
var repost_state_flag = obj.repost_state === 1 // 是否允许转发（目前帖子不能关闭分享）
console.log( obj.post_comment_authory ,'obj.post_comment_authority ' )
console.log( obj.allow_likes_state ,'obj.allow_likes_state ' )
console.log( obj.repost_state ,'obj.repost_state ' )
var briefInfo= {
post_comment_authority_flag,
allow_likes_state_flag,
repost_state_flag,
}
that.briefInfo = briefInfo
// 赋值
setTimeout(()=>{
vmDetail.changeBrief(briefInfo)
},50)
}
that.getReplyList();
}
});
},
// 评论
getReplyList: function (params) {
var that = this;
var act = this.act;
var replyList = this.replyList;
// 是否第一次加载
var obj = actions[act];
var list = replyList[act];
// 请求
$.ajax({
url: apis.replyList,
type: "GET",
dataType: "jsonp", //指定服务器返回的数据类型
jsonpCallback: "jsonpdata",
data: Object.assign({
type: 0, ps: 20, p: 1, sort: 1, sorttype: 1, deviceid: 1, IsTC: false
}, params ? params : {}, baseParams),
success: function (data) {
var re = data.re;
var count = data.count;
if(re){
re.forEach(function (item) {
var reply_time = item.reply_time;
var user_id = item.reply_user.user_id;
item.reply_time_format = reply_time ? reply_time.substring(0, reply_time.length - 3) : '';
var childReplys = that.fmtData(item.child_replys, user_id)
list.push(Object.assign(item, { p: 1, childReplys: childReplys }));
})
}
// 判断是否全部加载
if (list.length >= count) {
obj.finishedFlg = true
} else {
obj.opt.p += 1
obj.finishedFlg = false
}
// 首次，显示5条
that.list = obj.initFlg ? list.slice(0, 5) : list;
// that.calcExpand();
}
});
},
// 子评论
getReplyDetail: function (replyid) {
var that = this;
var act = this.act;
var replyList = this.replyList;
var list = replyList[act];
// 筛选
var index = list.findIndex(function(item) {
return item.reply_id === replyid;
});
var arr = list[index];
// 请求
$.ajax({
url: apis.replyDetail,
type: "GET",
dataType: "jsonp", //指定服务器返回的数据类型
jsonpCallback: "jsonpdata",
data: Object.assign({
replyid: replyid,
p: arr.p,
ps: 10,
sort: 1,
sorttype: 1,
type: 0,
}, baseParams),
success: function (data) {
var count = data.count;
var child_replys = data.re.child_replys;
arr.p === 1 && (arr.childReplys = []);
console.log(arr.p)
var childReplys = that.fmtData(child_replys, replyid);
// // 判断是否全部加载
// 添加
childReplys.forEach(function(item) {
arr.childReplys.push(item)
})
arr.childReplys.length < count && (arr.p += 1);
}
});
},
fmtData: function (list, user_id) {
var childReplys = [];
if (list.length === 0) return [];
list.forEach(function (t) {
var reply_user_id = t.source_reply[0].source_reply_user_id;
childReplys.push(Object.assign(t, {
// 图片
reply_picture: t.reply_picture,
// 内容
reply_text: t.reply_text,
// 回复人
user_nickname: t.reply_user.user_nickname,
// 被回复人通行证
reply_user_id: reply_user_id,
// 被回复人
reply_user_nickname: t.source_reply[0].source_reply_user_nickname,
// 是评论还是回复评论
isComment: user_id == reply_user_id,
reply_time: t.reply_time.substring(0, t.reply_time.length - 3)
}));
})
return childReplys;
},
// 切换最新 最热 最早
handleSelectClick: function (idx) {
var replyList = this.replyList;
var getReplyList = this.getReplyList;
var list = replyList[idx];
// 赋值
Object.assign(this, {act: idx})
// 无数据，请求
list.length === 0 ? getReplyList(actions[idx].opt) : this.list = list
},
// 更多评论
handleMoreClick: function () {
var act = this.act;
var replyList = this.replyList;
var getReplyList = this.getReplyList;
var initFlg = actions[act].initFlg;
// 最初显示五条，第一次加载，加载剩余的部分
if (initFlg) {
actions[act].initFlg = false;
this.list = replyList[act];
return;
}
// 请求
getReplyList(actions[act].opt);
},
getNewsId: function () {
var articleid = location.href.replace(/.*news\/(\d+).*/, '$1');
// 赋值参数信息
articleid && Object.assign(baseParams, {
postid: articleid
});
return articleid;
},
formatNum: function (num) {
return num < 10000 ? num : (num / 10000).toFixed(1) + '万';
},
handleExpandClick: function () {
var expandFlg = this.expandFlg;
this.expandFlg = !expandFlg;
},
// 计算是否展开评论
calcExpand: function () {
// console.log(that.$refs.text)
},
handleJumpClick: function (url) {
if (window.pcBridge && window.pcBridge.isInQTUOS) {
return window.pcBridge.OpenInBrowser(url)
}
if (typeof window.OpenInBrowser === 'function') {
window.OpenInBrowser(url)
}
},
getListLength:function(){
console.log(this.list,'list')
console.log(this.list.length,'list.length')
return this.list.length
},
}
})
</script>
