    <script>
        $(".content").scroll(function () {
            if ($("#mycity").height()) {
                if ($(this).scrollTop() > $(".top-banner a").height()) {
                    $("#mycity").addClass("current-target")
                    $(".h-nav").css("padding-top", $("#mycity").height())
                } else {
                    $("#mycity").removeClass("current-target")
                    $(".h-nav").css("padding-top", "0.3rem")
                }
            }
        })

        function replaceUrl(str) {
            if (str.indexOf("//") == 0) {
                str = "https:" + str
            }
            if (str.indexOf("_abc") !== -1) {
                return str
            }

            str = str.replace(".html", "_abc.html")
            var top = str.split("/")[2],
                bottom = str.split("/").slice(3).join("/")

            if (top.indexOf("100njz.com") > -1) {
                path = "https://m.100njz.com/" + bottom
            } else if(top.indexOf("bxg.mysteel.com") > -1){
                path = "https://bxg.m.mysteel.com/" + bottom
            } else if (top.indexOf("feibxg.mysteel.com") > -1) {
                path = "https://feibxg.m.mysteel.com/" + bottom
            } else if (top.indexOf("ge.mysteel.com") > -1) {
                path = "https://ge.m.mysteel.com/" + bottom
            } else {
                path = "https://m.mysteel.com/" + bottom
            }  

            return path
        }

        $("#mycity ul li").each(function (i) {
            if ($("body").attr("rootId") == "02") {
                if ($(this).text().indexOf("镍") > -1 || $(this).text().indexOf("铬") > -1) {
                    $(this).hide()
                }
            }
        })

        // 针对公司企业微信来更改页面标题和描述
        var ua = window.navigator.userAgent.toLowerCase();
        if ((ua.match(/MicroMessenger/i) == 'micromessenger') || (ua.match(/wxwork/i) == 'wxwork')) {
            document.title = "今日" + $("body").attr("city") + "价格资讯分析_我的钢铁网";
            jQuery('meta[name="description"]').attr('content', "我的钢铁网提供" + $("body").attr("city") + "价格走势分析," + $("body").attr("city") + "热点资讯,让您轻松了解" + $("body").attr("city") + "市场动态");
        }

    </script>
