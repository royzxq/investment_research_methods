    <script>
        function getCookie(c) {
            var a = document.cookie.lastIndexOf(c + "=");
            if (a == -1) {
                return null;
            }
            var d = document.cookie.substring(a + c.length + 1);
            var b = d.indexOf(";");
            if (b == -1) {
                b = d.length;
            }
            d = d.substring(0, b);
            d = unescape(d);
            return d;
        }

        if (!getCookie("_login_token")) {
            $(".suspend").show()
        }

