            <script>
            // 页面选项卡
            function tabBtn(_dom, _class, tabClass) {
                _dom.hover(function () {
                    $(this).addClass(_class).siblings().removeClass(_class);
                    $(this).parent().siblings(tabClass).hide();
                    $(this).parent().siblings(tabClass).eq($(this).index()).show();
                })
            }
            function tabBtn1(_dom, _class, tabClass) {
                _dom.hover(function () {
                    $(this).addClass(_class).siblings().removeClass(_class);
                    $(this).parent().parent().siblings(tabClass).hide();
                    $(this).parent().parent().siblings(tabClass).eq($(this).index()).show();
                })
            }     
            
            tabBtn($('#switch-button .btn-box a'), 'btnon', '.news-item'); 
            tabBtn($('#switch-button .column-btn-tab a'),'btnon','.hot-topic')
            tabBtn1($('#switch-button .column-title .column-btn-tab a'),'btnon','.hot-topic');//栏目标题下方子栏目选项卡
            //栏目标题选项卡
    </script>
        
