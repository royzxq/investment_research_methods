</script>
</span>
                        <span><img src="/cn/res/images/time.png" alt="">作者：</span>
                    </div>
                </div>
                <div class="InfoCon">
                    <p><span style="text-wrap-mode: wrap;"></span></p><p></p><p></p><p><span style="text-wrap-mode: wrap;"></span></p><p></p><p></p><table width="724"><tbody><tr style="height:80px" class="firstRow"><td width="724" valign="center" colspan="3" style="padding: 5px 10px; border-width: 1px; border-style: solid; border-color: rgb(0, 0, 0);"><p style=";text-align:center"><strong><span style="font-family:宋体;font-size:24px">大连商品交易所</span></strong></p></td></tr><tr style="height:27px"><td width="68" valign="center" rowspan="2" style="padding: 5px 10px; border-width: medium 1px 1px; border-style: none solid solid; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0);"><p style=";text-align:center"><strong><span style="font-family:宋体;font-size:16px">品种</span></strong></p></td><td width="168" valign="center" rowspan="2" style="padding: 5px 10px; border-width: 1px 1px 1px medium; border-style: solid solid solid none; border-color: rgb(0, 0, 0) rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p style=";text-align:center"><strong><span style="font-family:宋体;font-size:16px">仓储费</span></strong></p></td><td width="487" valign="center" rowspan="2" style="padding: 5px 10px; border-width: 1px 1px 1px medium; border-style: solid solid solid none; border-color: rgb(0, 0, 0) rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p><strong><span style="font-family:宋体;font-size:16px">仓单有效期</span></strong></p></td></tr><tr style="height:21px"></tr><tr style="height:99px"><td width="68" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px; border-style: none solid solid; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0);"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px"><span style="font-family:宋体">黄大豆</span>1号</span></p></td><td width="168" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px">5月1日—10月31日：</span><span style="font-family:宋体;font-size:16px"><br/></span><span style="font-family:宋体;font-size:16px">0.5元/吨</span><span style="font-family:宋体;font-size:16px">*</span><span style="font-family:宋体;font-size:16px">天；</span><span style="font-family:宋体;font-size:16px"><br/></span><span style="font-family:宋体;font-size:16px">11月1日—4月30日：</span><span style="font-family:宋体;font-size:16px"><br/></span><span style="font-family:宋体;font-size:16px">0.4元/吨天</span></p></td><td width="487" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p><span style="font-family:宋体;font-size:16px"><span style="font-family:宋体">每年的</span>3月份最后1个交易日之前应当进行标准仓单注销</span></p></td></tr><tr style="height:87px"><td width="68" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px; border-style: none solid solid; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0);"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px"><span style="font-family:宋体">黄大豆</span>2号</span></p></td><td width="168" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px">1元/吨</span><span style="font-family:宋体;font-size:16px">*</span><span style="font-family:宋体;font-size:16px">天</span></p></td><td width="487" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p><span style="font-family:宋体;font-size:16px"><span style="font-family:宋体">每个交割月份最后交割日后</span>3个交易日内应当进行标准仓单注销</span></p></td></tr><tr style="height:67px"><td width="68" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px; border-style: none solid solid; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0);"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px">豆粕</span></p></td><td width="168" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px">0.5元/吨*天</span></p></td><td width="487" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p><span style="font-family:宋体;font-size:16px"><span style="font-family:宋体">每年的</span>3、7、11月份最后1个交易日之前应当进行标准仓单注销</span></p></td></tr><tr style="height:67px"><td width="68" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px; border-style: none solid solid; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0);"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px">豆油</span></p></td><td width="168" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px">0.9元/吨*天</span></p></td><td width="487" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p><span style="font-family:宋体;font-size:16px"><span style="font-family:宋体">每年的</span>3、7、11月份最后1个交易日之前应当进行标准仓单注销</span></p></td></tr><tr style="height:67px"><td width="68" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px; border-style: none solid solid; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0);"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px">棕榈油</span></p></td><td width="168" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px">0.9元/吨*天</span></p></td><td width="487" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p><span style="font-family:宋体;font-size:16px"><span style="font-family:宋体">每个交割月份最后交割日后</span>3个交易日内应当进行标准仓单注销</span></p></td></tr><tr style="height:67px"><td width="68" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px; border-style: none solid solid; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0);"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px">玉米</span></p></td><td width="168" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p style=";text-align:center"><span style="font-family:宋体;font-size:16px">5月1日—10月31日：</span><span style="font-family:宋体;font-size:16px"><br/></span><span style="font-family:宋体;font-size:16px">0.6元/吨<span style="font-family: 宋体; text-align: center;">*</span>天；</span><span style="font-family:宋体;font-size:16px"><br/></span><span style="font-family:宋体;font-size:16px">11月1日—4月30日：</span><span style="font-family:宋体;font-size:16px"><br/></span><span style="font-family:宋体;font-size:16px">0.5元/吨<span style="font-family: 宋体; text-align: center;">*</span>天</span></p></td><td width="487" valign="center" style="padding: 5px 10px; border-width: medium 1px 1px medium; border-style: none solid solid none; border-color: currentcolor rgb(0, 0, 0) rgb(0, 0, 0) currentcolor;"><p><span style="font-family:宋体;font-size:16px"><span style="font-f