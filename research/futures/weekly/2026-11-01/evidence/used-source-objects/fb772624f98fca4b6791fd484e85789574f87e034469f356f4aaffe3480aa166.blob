  <h3 id="detail-title">广西糖厂陆续清库 10月份陈糖继续加快去库</h3> 
  <div class="article-detail-info"> 
   <p class="article-info"> <span>作者：</span> <span>来源：</span> <span>2026-10-28 09:46:36</span> </p> 
   <p class="article-function"> <span class="follow"><a onclick="mycollect4col()">关注 </a></span> <span class="shouc"><a onclick="mycollect4art()">收藏</a></span> </p> 
  </div> 
  <div class="article"> 
   <p>　　沐甜28日讯&nbsp; 据了解，10月23日忻城糖厂产“甜源”牌已清库，成为25/26榨季广西南华第五家清库的糖厂，目前仅余3个糖厂报价5170-5210元/吨。</p> 
   <p>　　凤糖也已清库六家糖厂，二级糖已经基本销售完毕，目前还有4个品牌不同品质糖报价。</p> 
   <p>　　湘桂仅余2个糖厂报价，26/27榨季新糖预售报价5430-5470元/吨。</p> 
   <p>　　东糖仅余1个厂仓、1个外仓报价；广糖还有4个厂仓、2个外仓报价，不过外仓库存已经不多，26/27榨季新糖预售报价5400-5430元/吨。</p> 
   <p>　　25/26榨季广西食糖累计产销率89.17%，同比降低3.99个百分点；结转工业库存83.34万吨，同比增加39.13万吨。</p> 
   <p>　　10月份广西糖厂陆续清库，广西南华清库2个仓库、凤糖3个、湘桂4个、东糖7个、广糖3个，广西陈糖继续加快去库。</p> 
  </div> 
  <div class="sm_arg" style="display:none">
    本站原创1 
  </div> 
  <div class="contain_sm" id="contain_sm"> 
  </div> 
  <script>
var article_dl2=0;
function tanchu(text){
    $('body').prepend('<div id="tanchu"><div class="tanchu-cover"></div><div class="tanchu-wrap"><div class="mian">'+text+'</div><div class="foot"><input type="submit" value="确定"/></div></div></div>')
    $('#tanchu').show();
    $('#tanchu input').click(function(){
      $('#tanchu').remove();
   })
 }
function mycollect4art(){
  	var URL =window.location.href;
	$.ajax({   
	     url:"/eportal/ui?pageId=1013825&struts.portlet.action=/portlet/collect!AddCollect4Art.action&moduleId=1234560d59e34834a8efb826a60d30f7",   
	     type:'post',    
	     async : false, //默认为true 异步   
	     data:{URL:URL},
	     error:function(){   
	       tanchu('出错了！') 
	     },   
	     success:function(data){   
	       if($.trim(data)=='success'){
                     tanchu('收藏成功！');
		    $('.article-detail-info .shouc').addClass('cur');
		    $('.article-detail-info .shouc').html('<a onclick="mycancelcollect4art()">已收藏</a>');
             }
               else if($.trim(data)=='fail'){tanchu('此文章您已收藏！')}
               else if($.trim(data)=='nolog'){
                  tanchu('请登录！');
                  article_dl2=1;
              } 
console.log(data);
	     }
	 });
}
function mycollect4col(){
  	var URL =window.location.href;
	$.ajax({   
	     url:"/eportal/ui?pageId=1013825&struts.portlet.action=/portlet/collect!AddCollect4Column.action&moduleId=1234560d59e34834a8efb826a60d30f7",   
	     type:'post',    
	     async : false, //默认为true 异步   
	     data:{URL:URL},
	     error:function(){   
	        tanchu('出错了！')   
	     },   
	     success:function(data){   
	       if($.trim(data)=='success'){
                  tanchu('关注成功！');
		  $('.article-detail-info .follow').addClass('cur');
		  $('.article-detail-info .follow a').html('已关注');

               }
               else if($.trim(data)=='fail'){
                 tanchu('此文章您已关注！');

               }else if($.trim(data)=='nolog'){
                  tanchu('请登录！');
                  article_dl2=1;
              }  
console.log(data);
	     }
	 });
}
function mycancelcollect4art(){
  	var URL =window.location.href;
	$.ajax({   
	     url:"/eportal/ui?struts.portlet.action=/portlet/collect!CancelCollect4ArtByUrl.action&moduleId=1234560d59e34834a8efb826a60d30f7",   
	     type:'post',    
	     async : false, //默认为true 异步   
	     data:{URL:URL},
	     error:function(){   
	       tanchu('出错了！') 
	     },   
	     success:function(data){   
	       if($.trim(data)=='success'){
                  tanchu('已取消收藏！')
		  $('.article-detail-info .shouc').removeClass('cur');
		  $('.article-detail-info .shouc').html('<a onclick="mycollect4art()">收藏</a>');
 
               }else if($.trim(data)=='fail'){
                  tanchu('取消收藏失败！');
               }else if($.trim(data)=='nolog'){
                  tanchu('请登录！');
                  article_dl2=1;
              } 
	     }
	 });
}
//浏览文章详细页
function ReadArt(){
	var url =window.location.href;
	$.ajax({   
	     url:"/eportal/ui?struts.portlet.action=/portlet/comm!artCountingAdd1.action&moduleId=1234560d59e34834a8efb826a60d30f7",    
	    type:'post',    
	    async : true, //默认为true 异步   
	    data:{url:url},
	    error:function(){   
	       ;   
	    },   
	    success:function(data){
	    	var json = eval("("+$.trim(data)+")");
		    if(json.status=="success"){
		   	 	console.log("成功");
		   	 	
		    }else{
		    	console.log("失败");
		    }
		    
		}
	});
}
$(function(){
	var URL =window.location.href;
	$.ajax({   
	     url:"/eportal/ui?struts.portlet.action=/portlet/collect!CheckCollect.action&moduleId=1234560d59e34834a8efb826a60d30f7",   
	     type:'post',    
	     async : false, //默认为true 异步   
	     data:{URL:URL},
	     error:function(){   
	        tanchu('出错了！')   
	     },   
	     success:function(data){   
	       var resultJson = eval("("+$.trim(data)+")");
		   var flag = resultJson.status;
		   var des = resultJson.des;
		   var articeExist = resultJson.articeExist;
		   var columnExist = resultJson.columnExist;
		   if(flag=="success"){
				if(articeExist=="true"){//文章已经收藏
					$('.article-detail-info .shouc').addClass('cur');
					$('.article-detail-info .shouc').html('<a onclick="mycancelcollect4art()">已收藏</a>');
				}
				if(columnExist=="true"){//栏目已经关注
					$('.article-detail-info .follow').addClass('cur');
					$('.article-detail-info .follow a').html('已关注');
				}
		   }else if(flag=="fail"){
				if(des=="nolog"){//用户没有登录
					console.log("用户没有登录");
				}else{//出错了
					console.log("出错了");
				}
		   }
	     }
	 });

   //详细页
   ReadArt()
});

</script> 
