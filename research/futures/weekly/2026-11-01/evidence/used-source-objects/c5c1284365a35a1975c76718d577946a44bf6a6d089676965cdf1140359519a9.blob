                if (!container) return;
                var re = /\s*\(\d+\)/g;
                // 处理 <a download="..."> 属性（pdf / doc / docx / xls / xlsx / zip / rar 等任意扩展名）
                container.querySelectorAll('a[download]').forEach(function (a) {
                    var v = a.getAttribute('download');
                    if (v) a.setAttribute('download', v.replace(re, ''));
                });
                // 处理可见文本（<span class="fs058">附件:N、xxx (1).pdf</span>）
                container.querySelectorAll('span.fs058').forEach(function (s) {
                    s.innerHTML = s.innerHTML.replace(re, '');
                });
            })();
        </script>
    </div>
</body>

</html>