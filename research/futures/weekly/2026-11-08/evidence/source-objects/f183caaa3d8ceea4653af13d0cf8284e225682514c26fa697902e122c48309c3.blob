  <script type="text/javascript">
//load 
$("#mtkj_news_details").load("/mtkj/index/index.html #mtkj_friends");
//涨跌调查

//结果

var ups_result = $('#ups_cont .easysite-look-result').attr('href');
var ups_tanchu = $('#ups_cont .easysite-join-survey').attr('href');

ups_result += ' #zhangdie_answer';
ups_tanchu += ' .d-content';

$('#ups_result').load(ups_result);

function zd_result() {
    $('#ups_result').load(ups_result);

}

//涨跌弹出


var j = 1;
var k = []
k[0] = 0

function zhangdie(text, a) {
    $('#zd_tanchu').show();
    $('#zd_bg2').show();
    $('#zd_tanchu').html('<div class="mian">' + text + '</div><div class="foot"><input type="submit" value="确定"/></div>');
    $('#zd_tanchu input').click(function() {
        $('#zd_tanchu').empty().hide();
        $('#zd_bg2').hide();
    })

    k[j] = a
    if (k[j] != k[j - 1] && k[j] == 1) {
        $('#ups_result').load(ups_result);
        k[j] = 0;
    }
    j++;
}
//声明
$(function() {
    var arg = $('.sm_arg').text();
    var arg2 = arg.match(/\d+/);

    $('.article_sm dd').each(function() {
        var can = $(this).find('.ms_arg2').text();
        var can2 = can.match(/\d+/);
        try {
            if (arg2[0] == can2[0]) {
                var htm = $(this).html();
                $('.contain_sm').html(htm);
                $('.contain_sm').show();
            }
        } catch (err) {
            $('.contain_sm').hide();
        }
    })

})
