            search,
          );
        }
        return appendSearch('https://m.10jqka.com.cn/', search);
      }
      return null;
    }

    var deviceInfo = getDeviceInfo();
    var currentPathname = window.location.pathname;
    var currentSearch = window.location.search;
    var redirectTarget = getRedirectTarget(
      deviceInfo,
      currentPathname,
      currentSearch,
      window.location.hash,
    );

    if (redirectTarget) {
      window.location.href = redirectTarget;
      return;
    }


    function shouldSkipBrowserCheck(deviceType) {
      var skipTypes = ['hexin_client', 'desktop_client', 'mobile', 'ipad'];
      return skipTypes.indexOf(deviceType) !== -1;
    }

    var deviceType = deviceInfo.type;

    if (shouldSkipBrowserCheck(deviceType)) {
      return;
    }

    function compareVersions(v1, v2) {
      var v1Parts = v1.split('.');
      var v2Parts = v2.split('.');
      for (var i = 0; i < v1Parts.length; i++) {
        v1Parts[i] = parseInt(v1Parts[i], 10) || 0;
      }
      for (var i = 0; i < v2Parts.length; i++) {
        v2Parts[i] = parseInt(v2Parts[i], 10) || 0;
      }
      var len = Math.max(v1Parts.length, v2Parts.length);
      for (var i = 0; i < len; i++) {
        var num1 = v1Parts[i] || 0;
        var num2 = v2Parts[i] || 0;
        if (num1 > num2) return 1;
        if (num1 < num2) return -1;
      }
      return 0;
    }

    function getBrowserVersion() {
      var ua = navigator.userAgent;
      if (navigator.userAgentData && navigator.userAgentData.brands) {
        var brands = navigator.userAgentData.brands;
        for (var i = 0; i < brands.length; i++) {
          var brand = brands[i];
          if (brand.brand === 'Chromium' || brand.brand === 'Google Chrome' || brand.brand === 'Microsoft Edge') {
            return brand.version;
          }
        }
      }
      var chromeMatch = ua.match(/Chrome\/([\d.]+)/);
      var firefoxMatch = ua.match(/Firefox\/([\d.]+)/);
      if (chromeMatch && chromeMatch[1]) return chromeMatch[1];
      if (firefoxMatch && firefoxMatch[1]) return firefoxMatch[1];
      return null;
    }

    var currentVersion = getBrowserVersion();
    var targetVersion = '84.0.0.0';

    if (currentVersion) {
      var comparison = compareVersions(currentVersion, targetVersion);
      if (comparison < 0) {
        var confirmMsg = '检测到您当前使用的浏览器版本较低，可能无法正常访问当前页面。为保障您的浏览体验，我们将为您切换至兼容性更好的旧版页面。';
