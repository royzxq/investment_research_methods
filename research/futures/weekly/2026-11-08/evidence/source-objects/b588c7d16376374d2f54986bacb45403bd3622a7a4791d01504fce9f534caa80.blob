    function getDeviceInfo() {
      var agent = navigator.userAgent.toLowerCase();
      var isHexinClient = /ihexin|hexin_gphone/.test(agent);
      var isDesktopClient =
        (window.external && 'createObject' in window.external) ||
        !!window.MacStockMetaData ||
        !!(window.HevoCef && 'IsHevoCef' in window.HevoCef);
      var isIPad = agent.indexOf('ipad') !== -1;
      var isMobile =
        !isIPad &&
        (agent.indexOf('android') !== -1 || agent.indexOf('mobile') !== -1);
      var deviceType;
      if (isHexinClient) {
        deviceType = 'hexin_client';
      } else if (isDesktopClient) {
        deviceType = 'desktop_client';
      } else if (isIPad) {
        deviceType = 'ipad';
      } else if (isMobile) {
        deviceType = 'mobile';
      } else {
        deviceType = 'pc';
      }
      return {
        type: deviceType,
        isHexinClient: isHexinClient,
        isDesktopClient: isDesktopClient,
        isMobile: isMobile
      };
    }

    function hasPcModeFlag(search, hash) {
      if (hash === '#pc') return true;
      if (!search) return false;
      try {
        return new URLSearchParams(search).has('pc');
      } catch (e) {
        return /(?:^|[?&])pc(?:=|&|$)/.test(search);
      }
    }

    function appendSearch(baseUrl, search) {
      return search ? baseUrl + search : baseUrl;
    }

    function getRedirectTarget(deviceInfo, pathname, search, hash) {
      var detailUrl = parseNewsDetailUrl(pathname, null, null);
      if (detailUrl && detailUrl.isEncrypted) {
        return null;
      }
      var seq = detailUrl ? detailUrl.seq : null;
      var date = detailUrl ? detailUrl.date : null;
      if (deviceInfo.isHexinClient) {
        if (seq) {
          return appendSearch('https://news.10jqka.com.cn/m' + seq + '/', search);
        }
        return null;
      }
      if (deviceInfo.isDesktopClient) {
        if (date && seq) {
          return appendSearch(
            'https://news.10jqka.com.cn/field/v1/' + date + '/' + seq + '.shtml',
            search,
          );
        }
        return null;
      }
      if (deviceInfo.isMobile && !hasPcModeFlag(search, hash)) {
        if (date && seq) {
          return appendSearch(
