                    var span1 = "<span class='date'>"+data.afterMarketList[i].publishTime +"</span>"
                    var list = "<li class='item item-market'>"+aTag+"<div class='other-info'>"+span+span1+"</div></li>"
                    $(".market-list").append(list);
                }else {
                    var aTagArticle = "<a target='_blank' href='" + data.afterMarketList[i].articleBean.url + "'>" + data.afterMarketList[i].articleBean.title + "</a>";
                    var pTagTitle = "<p class='tit'>" + aTagArticle + "</p>";
                    var pTagContent = "<p class='article-content'>" + data.afterMarketList[i].articleBean.content + "</p>";
                    var listArticle = "<li class='item item-market'>" + pTagTitle + pTagContent + "</li>";
                    $(".market-list").append(listArticle);
                }
            }
        }
