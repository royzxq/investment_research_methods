  "changes": [
    {
      "kind": "method_change",
      "status": "adopted",
      "summary": "R22及既有五项折扣交付接入",
      "definition": "canonical §6.6：身份、实测流动性、历史归因及前瞻机会成本分离，最终P1受原约束与机会成本较严者限制",
      "economic_reason": "防止标签/历史涨幅与经营价值和交易成本重复计价",
      "scope": "全部新准备A/H公司研究和周度元研究，旧冻结批次不追补",
      "positive_case": "B=85、U=80则P1=80；T1按原价值逻辑",
      "negative_case": "B=72、U=80则不再收紧；ETF身份不加价",
      "boundary_case": "前瞻缺口未量化；多情景不能共用最终折扣时仅报明确基准P1；旧R22残余不得累加",
      "compatibility_impact": "固定五折扣、v4/audit-v2不变；新旧方法不整体等价，旧快照发布需复核"
    },
    {
      "kind": "evidence_correction",
      "summary": "controls-v2旧隔离注记由已核PR51合并及后续adopted接续更正；不修改历史产物"
    },
    {
      "kind": "evidence_correction",
