  "changes": [
    {
      "kind": "method_change",
      "status": "adopted",
      "summary": "可持续分红明确进入V50并与P1/R22唯一计价衔接",
      "definition": "按canonical §4.1A，基于未来有权取得的可持续分配、折现与分配后剩余价值估值，主辅模型裁决和现金/资本/增长桥去重",
      "economic_reason": "使R22未量化时仍可识别可持续股东现金回报，防止分配与留存或完整估值重复计价",
      "scope": "全部A/H研究说明适用性，稳态现金流/红利底仓/分红为重要持有理由者展示计算",
      "positive_case": "D1=5,k_e=10%,g_D=2%时V50=62.5，基础折扣10%且其余0时P1=56.25，即使R22未量化",
      "negative_case": "完整PE/FCFE权益价值再加相同股息现值，或同一风险既进折现率又扣折扣，均不允许",
      "boundary_case": "特别分配减少剩余资产，已除息权利排除，unknown不填0，k_e≤g_D停止永续式，有可靠替代估值则继续",
      "compatibility_impact": "v4/audit-v2接口兼容，方法语义有变化，旧快照发布前needs_review，新快照exact并采用新接续"
    }
  ],
