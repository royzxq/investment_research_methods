  "changes": [
    {
      "kind": "method_change",
      "status": "adopted",
      "summary": "本地dev采纳资本/风险去重及DCF估值审计；周更完成登记保留原合同完整门禁。",
      "definition": "canonical §4.1B–D、§5.2A；新准备controls-v7/audit-v4，旧冻结按原合同。",
      "economic_reason": "独立经营预测后核倍数、资本桥和市场隐含条件；不以贴市价或触价率调参。",
      "scope": "股票估值、审计、恢复及周更完成验收；不改变正式报价、交易链路、冷却或市场观测。",
      "positive_case": "同包独立正向估值可逐年复算，完整验收和按scope约束合取后才登记研究完成。",
      "negative_case": "缺acceptance/lifecycle的v3/v4算术块不算completed；同一损失不重复扣价。",
      "boundary_case": "旧audit-v2不追补新字段；零终值需明确零增长零利润；反解无根不等于所有业务路径不可达。",
      "compatibility_impact": "旧冻结字节不变；实质方法变更不声明全局等价。原pending、触发及证据日保留，不把隔离实验当完成。"
    }
  ],
