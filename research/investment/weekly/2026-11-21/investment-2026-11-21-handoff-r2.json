  "changes": [
    {
      "kind": "method_change",
      "status": "adopted",
      "summary": "创新药专项在研究当天留底，并在关键结果披露后对照复核。",
      "definition": "留存时点、原始输入、判断、每股情景差异及下一披露预期。披露后对照并单独测算受影响假设的每股改变量。",
      "economic_reason": "同日记录使后续复评能辨认临床、时间、销量与归属现金的预测偏差。",
      "scope": "仅供普通股票研究实际触发创新药补充模板时使用。",
      "positive_case": "核心适应症披露临床结果，引用原判断和新来源，复核该项判断。",
      "negative_case": "少数核心管线成败对整体估值影响有限，沿用普通股研究。",
      "boundary_case": "阶段性披露先复核已验证部分。历史缺少当日底稿时标注事后重建。",
      "compatibility_impact": "新准备任务按新指纹接续。旧快照及原维护记录继续按其原有指纹可用。"
    }
  ],
